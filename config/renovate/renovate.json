{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignorePresets": [
    "group:monorepos"
  ],
  "prHourlyLimit": 0,
  "branchTopic": "{{#if (containsString packageFile 'argocd/')}}{{depType}}{{else if (containsString packageFile '.github/')}}github{{else}}{{{replace '^[^/]+/[^/]+/([^/]+)/.*$' '$1' packageFile}}}{{/if}}{{#if isMajor}}-major{{/if}}",
  "commitMessagePrefix": "{{#if (containsString packageFile 'argocd/')}}{{depType}}{{else if (containsString packageFile '.github/')}}github{{else}}{{{replace '^[^/]+/[^/]+/([^/]+)/.*$' '$1' packageFile}}}{{/if}}:",
  "commitMessageAction": "Upgrade",
  "kubernetes": {
    "managerFilePatterns": [
      "/^manifests/.+\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Argo CD Helm charts, grouped by app",
      "managerFilePatterns": [
        "/^argocd/apps/.+\\.ya?ml$/"
      ],
      "matchStringsStrategy": "recursive",
      "matchStrings": [
        "  - name: (?<depType>\\S+)\\n(?:(?:    .*)?\\n)*",
        "repoURL: (?<registryUrl>https?://\\S+?)/?\\s+targetRevision: ['\"]?(?<currentValue>[^'\"\\s]+)['\"]?\\s+chart: (?<depName>\\S+)"
      ],
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "description": "Argo CD OCI charts, grouped by app",
      "managerFilePatterns": [
        "/^argocd/apps/.+\\.ya?ml$/"
      ],
      "matchStringsStrategy": "recursive",
      "matchStrings": [
        "  - name: (?<depType>\\S+)\\n(?:(?:    .*)?\\n)*",
        "repoURL: oci://(?<packageName>\\S+)\\s+targetRevision: ['\"]?(?<currentValue>[^'\"\\s]+)['\"]?\\s+chart: (?<depName>\\S+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "OpenClaw image version",
      "managerFilePatterns": [
        "/^helm/apps/openclaw/values\\.yaml$/"
      ],
      "matchStrings": [
        "openclawVersion: ['\"]?(?<currentValue>[^'\"\\s]+)"
      ],
      "depNameTemplate": "ghcr.io/openclaw/openclaw",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Tempo image tag",
      "managerFilePatterns": [
        "/^helm/monitoring/grafana-tempo/values\\.yaml$/"
      ],
      "matchStrings": [
        "tempo:\\s+repository: \\S+\\s+tag: ['\"]?(?<currentValue>[^'\"\\s]+)"
      ],
      "depNameTemplate": "grafana/tempo",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Titles read '<app>: Upgrade to v<version>'; digests '<app>: Upgrade <image> digest to <digest>'",
      "matchDepNames": [
        "*"
      ],
      "commitMessageTopic": "{{#if (equals updateType 'digest')}}{{{replace '^.*/' '' depName}}} digest{{else}}to v{{{replace '^v' '' newVersion}}}{{/if}}",
      "commitMessageExtra": "{{#if (equals updateType 'digest')}}to {{{newDigestShort}}}{{/if}}"
    },
    {
      "description": "Digest updates get their own '<app>-digest' PR so they never hide the app's version in its title",
      "matchUpdateTypes": [
        "digest"
      ],
      "branchTopic": "{{#if (containsString packageFile 'argocd/')}}{{depType}}{{else if (containsString packageFile '.github/')}}github{{else}}{{{replace '^[^/]+/[^/]+/([^/]+)/.*$' '$1' packageFile}}}{{/if}}-digest"
    },
    {
      "description": "Alloy updates restart Beyla",
      "matchDepNames": [
        "alloy",
        "grafana/alloy"
      ],
      "labels": [
        "restarts-beyla"
      ],
      "prBodyNotes": [
        "Merging this restarts Alloy and its embedded Beyla. If ingresses stall afterwards, detach the root-cgroup `obi_sockmap_tracker` link: `sudo bpftool cgroup show /sys/fs/cgroup`, then `sudo bpftool link detach id <id>`."
      ]
    },
    {
      "description": "Date-stamped utility image",
      "matchPackageNames": [
        "skullfighter6/python"
      ],
      "versioning": "regex:^(?<compatibility>\\d+\\.\\d+-utils)-(?<major>\\d+)$"
    },
    {
      "description": "Custom-built Postgres image uses its own tag scheme",
      "matchPackageNames": [
        "skullfighter6/percona-postgresql-vectorchord"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)-(?<patch>\\d+)-(?<compatibility>vchord.+)$"
    },
    {
      "description": "OpenClaw's tag is a template, the openclawVersion regex manager tracks it",
      "matchManagers": [
        "helm-values"
      ],
      "matchFileNames": [
        "helm/apps/openclaw/values.yaml"
      ],
      "enabled": false
    }
  ],
  "prBodyTemplate": "{{{header}}}\n\n{{{replace '^\\s*This PR contains the following updates:\\s*' '' table}}}\n\n{{#if changelogs}}### Release notes\n\n{{{replace '^\\s*---\\s*### Release Notes\\s*' '' changelogs}}}{{/if}}",
  "prBodyDefinitions": {
    "Type": "{{#if (containsString packageFile 'argocd/')}}chart{{else if (equals datasource 'docker')}}image{{else if (equals manager 'github-actions')}}action{{else}}{{datasource}}{{/if}}",
    "Released": "{{#if releaseTimestamp}}{{{replace '^(\\d{4})-(\\d{2})-(\\d{2}).*$' '$3/$2/$1' releaseTimestamp}}}{{/if}}"
  },
  "prHeader": "### Upgrades",
  "prBodyColumns": [
    "Package",
    "Type",
    "Update",
    "Change",
    "Released"
  ]
}
