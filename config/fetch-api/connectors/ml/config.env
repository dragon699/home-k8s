LISTEN_HOST=0.0.0.0
LISTEN_PORT=9069

LOG_FORMAT=json
LOG_LEVEL=debug

OTEL_SERVICE_NAME=connector-ml
OTEL_SERVICE_NAMESPACE=fetch-api
OTLP_ENDPOINT_HTTP=http://grafana-alloy.monitoring.svc:4318

HEALTH_CHECK_INTERVAL_SECONDS=60
HEALTH_RETRY_INTERVAL_SECONDS=5


# Provider and model settings
DEFAULT_PROVIDER=openclaw
DEFAULT_MODEL=openai/gpt-6-sol

OLLAMA_DEFAULT_MODEL=llama3.1:8b-instruct-q4_K_M
OLLAMA_TIMEOUT_SECONDS=30

OPENCLAW_DEFAULT_MODEL=openclaw/tesla-analyst
OPENCLAW_TIMEOUT_SECONDS=30

DEFAULT_KEEP_ALIVE_MINUTES=15
DEFAULT_TEMPERATURE=0.6
