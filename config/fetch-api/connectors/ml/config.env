LISTEN_HOST=0.0.0.0
LISTEN_PORT=9069

LOG_FORMAT=json
LOG_LEVEL=debug

OTEL_SERVICE_NAME=connector-ml
OTEL_SERVICE_NAMESPACE=fetch-api
OTLP_ENDPOINT_HTTP=http://grafana-alloy.monitoring.svc:4318

LAUNCHDARKLY_FLAG_ENABLE_AI_SUMMARY=enable_ai_summary

HEALTH_CHECK_INTERVAL_SECONDS=60
HEALTH_RETRY_INTERVAL_SECONDS=5


# Ollama settings
DEFAULT_MODEL=llama3.1:8b-instruct-q4_K_M
DEFAULT_KEEP_ALIVE_MINUTES=15
DEFAULT_TEMPERATURE=0.6
